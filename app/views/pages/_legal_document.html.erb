<div class="bg-white px-6 py-12 sm:py-16 lg:px-8">
  <article lang="fr" aria-labelledby="legal-document-title" class="mx-auto max-w-3xl">
    <header class="mb-10 border-b border-gray-100 pb-8">
      <%= link_to "Retour à l’accueil", root_path, class: "text-sm font-medium text-gray-600 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-500" %>
      <h1 id="legal-document-title" class="mt-6 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= title %></h1>
      <p class="mt-4 text-sm leading-6 text-gray-500">Les Artisans du Store</p>
    </header>

    <div class="prose prose-gray max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-violet-700 prose-a:underline-offset-2">
      <%= yield %>
    </div>
  </article>
</div>
